<Window x:Class="WpfApp_CLassesShop.OrderHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_CLassesShop"
        mc:Ignorable="d"
        Title="OrderHistoryWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="LỊCH SỬ ĐƠN HÀNG CỦA BẠN" FontSize="22" FontWeight="Bold" 
               Foreground="#2E86C1" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <DataGrid x:Name="dgOrders" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
              HeadersVisibility="Column" Background="White" RowHeight="35" FontSize="14"
              AlternatingRowBackground="#F2F4F4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" Width="150" FontWeight="SemiBold"/>

                <DataGridTextColumn Header="Ngày Đặt" Binding="{Binding OrderDate, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>

                <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TotalAmount, StringFormat={}{0:N0} đ}" Width="120" Foreground="#D35400" FontWeight="Bold"/>

                <DataGridTextColumn Header="Phương Thức" Binding="{Binding PaymentMethod}" Width="120"/>

                <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#27AE60"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Hành động" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Chi tiết" Background="#3498DB" Foreground="White" 
                                Cursor="Hand" Click="btnViewDetails_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
