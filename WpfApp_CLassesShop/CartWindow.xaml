<Window x:Class="WpfApp_CLassesShop.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_CLassesShop"
        mc:Ignorable="d"
        Title="Giỏ hàng của bạn" Height="450" Width="700"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9" Loaded="Window_Loaded" >

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🛒 GIỎ HÀNG CỦA BẠN" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <DataGrid x:Name="dgCart" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  HeadersVisibility="Column" Background="White" RowHeight="35" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Màu" Binding="{Binding Color}" Width="80"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="100"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="120"/>
                <DataGridTemplateColumn Header="Số lượng" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content=" - " Width="25" Height="25" FontWeight="Bold" Cursor="Hand" Background="#BDC3C7" Click="btnDecrease_Click"/>

                                <TextBlock Text="{Binding Quantity}" Width="35" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="5,0"/>

                                <Button Content=" + " Width="25" Height="25" FontWeight="Bold" Cursor="Hand" Background="#BDC3C7" Click="btnIncrease_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Hành động" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Xóa hẳn" Background="#E74C3C" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="btnRemoveAll_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tổng cộng: " FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="txtTotalAmount" Text="0 VNĐ" FontSize="20" FontWeight="Bold" Foreground="#E74C3C"/>
            </StackPanel>

            <Button Grid.Column="1" Content="💳 THANH TOÁN (CHECKOUT)" Width="200" Height="45" 
                    Background="#2980B9" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand"
                    Click="btnCheckout_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
