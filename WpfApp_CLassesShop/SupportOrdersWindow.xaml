<Window x:Class="WpfApp_CLassesShop.SupportOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support Staff - Quản lý đơn hàng"
        Height="650" Width="1200"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="#F5F7FB" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="txtWelcome"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Làm mới"
                            Width="110" Height="38" Margin="0,0,10,0"
                            Click="btnRefresh_Click"/>
                    <Button Content="Đăng xuất"
                            Width="110" Height="38"
                            Background="#EF4444"
                            Foreground="White"
                            Click="btnLogout_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16">
            <DataGrid x:Name="dgOrders"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderCode}" Width="130"/>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding Account.FullName}" Width="170"/>
                    <DataGridTextColumn Header="Người nhận" Binding="{Binding ReceiverName}" Width="150"/>
                    <DataGridTextColumn Header="SĐT" Binding="{Binding Phone}" Width="110"/>
                    <DataGridTextColumn Header="Địa chỉ giao" Binding="{Binding ShippingAddress}" Width="220"/>
                    <DataGridTextColumn Header="Ngày đặt" Binding="{Binding OrderDate, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat=N0}" Width="120"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Xem chi tiết"
                    Width="120" Height="38" Margin="0,0,10,0"
                    Click="btnViewDetails_Click"/>
            <Button Content="Xác nhận đơn"
                    Width="120" Height="38" Margin="0,0,10,0"
                    Background="#2563EB" Foreground="White"
                    Click="btnConfirm_Click"/>
            <Button Content="Hoàn tất đơn"
                    Width="120" Height="38" Margin="0,0,10,0"
                    Background="#16A34A" Foreground="White"
                    Click="btnComplete_Click"/>
            <Button Content="Hủy đơn"
                    Width="120" Height="38"
                    Background="#DC2626" Foreground="White"
                    Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>