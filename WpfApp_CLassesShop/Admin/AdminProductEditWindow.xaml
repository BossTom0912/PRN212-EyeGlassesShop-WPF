<Window x:Class="WpfApp_CLassesShop.Admin.AdminProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm / Sửa sản phẩm"
        Height="720" Width="720"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Thông tin sản phẩm" Grid.Row="0" Margin="0,0,0,12">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Tên sản phẩm"/>
                    <TextBox x:Name="txtProductName" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Height="30"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Top" Text="Mô tả"/>
                    <TextBox x:Name="txtDescription" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Brand"/>
                    <ComboBox x:Name="cbBrand" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Height="30"
                              DisplayMemberPath="Name" SelectedValuePath="Id"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Category"/>
                    <ComboBox x:Name="cbCategory" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Height="30"
                              DisplayMemberPath="Name" SelectedValuePath="Id"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Base Image URL"/>
                    <TextBox x:Name="txtBaseImageUrl" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Height="30"/>

                    <CheckBox x:Name="chkProductActive" Grid.Row="5" Grid.Column="1" Content="Sản phẩm đang hoạt động" IsChecked="True"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Thông tin biến thể" Grid.Row="1" Margin="0,0,0,12">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="SKU"/>
                    <TextBox x:Name="txtSku" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Height="30"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Màu sắc"/>
                    <TextBox x:Name="txtColor" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Height="30"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Kích thước"/>
                    <TextBox x:Name="txtSize" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Height="30"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Chất liệu"/>
                    <TextBox x:Name="txtMaterial" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Height="30"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Giá"/>
                    <TextBox x:Name="txtPrice" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Height="30"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Tồn kho"/>
                    <TextBox x:Name="txtStock" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" Height="30"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Image URL"/>
                    <TextBox x:Name="txtVariantImageUrl" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Height="30"/>

                    <CheckBox x:Name="chkVariantActive" Grid.Row="7" Grid.Column="1" Content="Biến thể đang hoạt động" IsChecked="True"/>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Lưu" Width="100" Height="34" Margin="0,0,10,0" Click="BtnSave_Click"/>
                <Button Content="Hủy" Width="100" Height="34" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>