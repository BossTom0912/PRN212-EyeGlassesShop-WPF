<Window x:Class="WpfApp_CLassesShop.Admin.AdminUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_CLassesShop.Admin"
        mc:Ignorable="d"
        Title="AdminUsersWindow" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
            <Button Content="Khóa / Mở Tài Khoản" Width="150" Height="35" Click="BtnToggleActive_Click"/>
            <Button Content="Tải lại dữ liệu" Width="100" Height="35" Margin="10,0,0,0" Click="BtnReload_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgUsers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Họ Tên" Binding="{Binding FullName}" Width="150"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                <DataGridTextColumn Header="Số điện thoại" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Vai trò" Binding="{Binding Role.Name}" Width="100"/>
                <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
