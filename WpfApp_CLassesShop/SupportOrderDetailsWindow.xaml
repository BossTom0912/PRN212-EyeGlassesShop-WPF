<Window x:Class="WpfApp_CLassesShop.SupportOrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết đơn hàng - Support"
        Height="620" Width="980"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="#F5F7FB" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Thông tin đơn hàng" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="txtOrderCode" Margin="0,4"/>
                    <TextBlock x:Name="txtCustomerName" Margin="0,4"/>
                    <TextBlock x:Name="txtReceiverName" Margin="0,4"/>
                    <TextBlock x:Name="txtPhone" Margin="0,4"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Thông tin giao hàng" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="txtAddress" Margin="0,4" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtStatus" Margin="0,4"/>
                    <TextBlock x:Name="txtPaymentMethod" Margin="0,4"/>
                    <TextBlock x:Name="txtTotalAmount" Margin="0,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16">
            <DataGrid x:Name="dgOrderItems"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductNameSnapshot}" Width="220"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding SkuSnapshot}" Width="140"/>
                    <DataGridTextColumn Header="Màu" Binding="{Binding ColorSnapshot}" Width="100"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeSnapshot}" Width="100"/>
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" Width="120"/>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="90"/>
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding SubTotal, StringFormat=N0}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Button Grid.Row="2"
                Content="Đóng"
                Width="120" Height="38"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="btnClose_Click"/>
    </Grid>
</Window>